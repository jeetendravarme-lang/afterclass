# --- Supabase (required for auth, chat, and all saved data) ---
# Create a free project at https://supabase.com/dashboard then copy these
# from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service-role key is ONLY used by server-side API routes. Never expose it
# in NEXT_PUBLIC_ vars or in frontend code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- LiveKit (required for video / voice calling) ---
# Create a free Cloud project at https://cloud.livekit.io then copy these
# from Settings -> Keys. Tokens are generated server-side only.
LIVEKIT_URL=wss://YOUR_PROJECT-xxxx.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# --- Invite code (required for signup) ---
# New accounts can ONLY be created with this code. Keep it private — share
# it only with the 5 friends. The code is checked SERVER-SIDE in
# app/api/signup against this env var; it never appears in frontend code
# and must never be committed with a real value.
# Generate a strong random code, e.g.: openssl rand -hex 8
INVITE_CODE=YOUR_INVITE_CODE_HERE
